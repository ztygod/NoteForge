# Local Ollama is the easiest configuration for a first run.
# Run `ollama pull qwen2.5:7b` and keep the Ollama service available.
# NOTEFORGE_LLM_PROVIDER is a legacy-compatible name: its value selects the
# API wire format, not the company operating the model endpoint.
NOTEFORGE_LLM_PROVIDER=ollama
NOTEFORGE_LLM_MODEL=qwen2.5:7b
NOTEFORGE_LLM_BASE_URL=http://localhost:11434
NOTEFORGE_LLM_TIMEOUT_SECONDS=120

# OpenAI-compatible API format example (OpenAI, DeepSeek, or another compatible endpoint):
# NOTEFORGE_LLM_PROVIDER=openai
# NOTEFORGE_LLM_MODEL=<an-available-chat-completions-model>
# NOTEFORGE_LLM_API_KEY=<your-api-key>
# NOTEFORGE_LLM_BASE_URL=https://api.openai.com/v1

# Anthropic Messages API format example:
# NOTEFORGE_LLM_PROVIDER=anthropic
# NOTEFORGE_LLM_MODEL=<an-available-anthropic-model>
# NOTEFORGE_LLM_API_KEY=<your-api-key>
# NOTEFORGE_LLM_BASE_URL=https://api.anthropic.com/v1
